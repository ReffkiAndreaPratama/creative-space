# ──────────────────────────────────────────────
# Nexreff Creative Space — Environment Variables
# ──────────────────────────────────────────────
#
# Copy this file to `.env` and fill in your Supabase credentials.
# DO NOT commit the real `.env` file.
#
# These are PUBLIC (anon/publishable) keys — safe to expose in the browser.
# They are protected by Row Level Security (RLS) policies.
#
# NEVER put your Supabase service_role key here.
# The service_role key must ONLY be used server-side (e.g. Supabase Edge Functions
# or the Supabase Dashboard SQL editor). It must NEVER be embedded in frontend code.

# Your Supabase project URL, e.g. https://yourproject.supabase.co
VITE_SUPABASE_URL=

# Your Supabase anon/publishable key (found in Supabase Dashboard → Settings → API)
VITE_SUPABASE_PUBLISHABLE_KEY=
